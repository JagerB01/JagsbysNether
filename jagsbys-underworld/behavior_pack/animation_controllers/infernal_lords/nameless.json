{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.nameless_one.casting": {
      "initial_state": "not_casting",
      "states": {
        "casting": {
          "on_exit": [
            "/event entity @s dungeons:complete_casting"
          ],
          "transitions": [
            {
              "not_casting": "!q.is_casting"
            }
          ]
        },
        "not_casting": {
          "on_exit": [
            "/event entity @s dungeons:begin_casting"
          ],
          "transitions": [
            {
              "casting": "query.is_casting"
            }
          ]
        }
      }
    }
  }
}