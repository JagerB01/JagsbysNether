{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:boss_wildfire",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "dungeons:shields": {
          "type": "int",
          "client_sync": true,
          "range": [
            0,
            4
          ],
          "default": 4
        },
        "dungeons:durability": {
          "type": "int",
          "client_sync": false,
          "range": [
            0,
            10
          ],
          "default": 10
        }
      }
    },
    "component_groups": {
      "dungeons:shockwave_cooldown": {
        "minecraft:shooter": {
          "def": "dungeons:boss_wildfire_fireball"
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 3,
          "burst_shots": 3,
          "burst_interval": 0.3,
          "charge_charged_trigger": 0,
          "charge_shoot_trigger": 1,
          "attack_interval_min": 0.66,
          "attack_interval_max": 1.32,
          "attack_radius": 20
        },
        "minecraft:behavior.avoid_mob_type": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_target",
                    "subject": "other"
                  }
                ]
              },
              "max_dist": 6,
              "max_flee": 5,
              "walk_speed_multiplier": 1.5,
              "sprint_speed_multiplier": 1.5
            }
          ]
        },
        "minecraft:timer": {
          "looping": false,
          "time": [
            15,
            20
          ],
          "time_down_event": {
            "event": "dungeons:end_cooldown",
            "target": "self"
          }
        }
      },
      "dungeons:shockwave_ready": {
        "minecraft:shooter": {
          "def": "dungeons:boss_wildfire_fireball"
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 3,
          "burst_shots": 3,
          "burst_interval": 0.3,
          "charge_charged_trigger": 0,
          "charge_shoot_trigger": 1,
          "attack_interval_min": 0.75,
          "attack_interval_max": 1.5,
          "attack_radius": 20
        },
        "minecraft:entity_sensor": {
          "subsensors": [
            {
              "range": [
                4,
                4
              ],
              "minimum_count": 1,
              "cooldown": 1,
              "event_filters": {
                "any_of": [
                  {
                    "all_of": [
                      {
                        "test": "is_family",
                        "subject": "other",
                        "value": "player"
                      },
                      {
                        "test": "has_ability",
                        "subject": "other",
                        "value": "instabuild",
                        "operator": "not"
                      }
                    ]
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "snowgolem"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "irongolem"
                  }
                ]
              },
              "event": "dungeons:begin_shockwave"
            }
          ]
        }
      },
      "dungeons:shockwave_action": {
        "minecraft:timer": {
          "looping": false,
          "time": 0.51,
          "time_down_event": {
            "event": "dungeons:shockwave_damage",
            "target": "self"
          }
        }
      },
      "dungeons:shielded": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "lava",
              "deals_damage": "no"
            },
            {
              "cause": "fire_tick",
              "deals_damage": "no"
            },
            {
              "cause": "fire",
              "deals_damage": "no"
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "any_of": [
                        {
                          "test": "is_family",
                          "subject": "other",
                          "value": "mob"
                        },
                        {
                          "test": "is_family",
                          "subject": "other",
                          "value": "player"
                        },
                        {
                          "test": "is_family",
                          "subject": "other",
                          "value": "artefact"
                        }
                      ]
                    },
                    {
                      "test": "int_property",
                      "subject": "self",
                      "domain": "dungeons:durability",
                      "operator": ">=",
                      "value": 1
                    }
                  ]
                },
                "event": "dungeons:harm_shield"
              },
              "deals_damage": false
            },
            {
              "on_damage": {
                "filters": {
                  "all_of": [
                    {
                      "any_of": [
                        {
                          "test": "is_family",
                          "subject": "other",
                          "value": "mob"
                        },
                        {
                          "test": "is_family",
                          "subject": "other",
                          "value": "player"
                        },
                        {
                          "test": "is_family",
                          "subject": "other",
                          "value": "artefact"
                        }
                      ]
                    },
                    {
                      "test": "int_property",
                      "subject": "self",
                      "domain": "dungeons:durability",
                      "operator": "==",
                      "value": 0
                    }
                  ]
                },
                "event": "dungeons:destroy_shield"
              },
              "deals_damage": false
            },
            {
              "cause": "fall",
              "deals_damage": false
            },
            {
              "cause": "projectile",
              "deals_damage": false
            }
          ]
        },
        "minecraft:knockback_resistance": {
          "value": 0.9
        },
        "minecraft:reflect_projectiles": {
          "reflected_projectiles": [
            "experience_bottle",
            "thrown_trident",
            "shulker_bullet",
            "dragon_fireball",
            "arrow",
            "snowball",
            "thrownegg",
            "fireball",
            "splash_potion",
            "ender_pearl",
            "thrownenderpearl",
            "wither_skull",
            "small_fireball",
            "lingering_potion",
            "llama_spit",
            "evocation_fang",
            "ice_bomb",
            "thrownicebomb"
          ],
          "azimuth_angle": "180.0 + Math.random(-5.0, 5.0)",
          "reflection_scale": "0.125"
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "int_property",
                    "subject": "self",
                    "domain": "dungeons:shields",
                    "operator": "==",
                    "value": 0
                  }
                ]
              },
              "event": "dungeons:shields_down"
            }
          ]
        }
      },
      "dungeons:no_shield": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "int_property",
                    "subject": "self",
                    "domain": "dungeons:shields",
                    "operator": ">=",
                    "value": 1
                  }
                ]
              },
              "event": "dungeons:shields_up"
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "lava",
              "deals_damage": "no"
            },
            {
              "cause": "fire_tick",
              "deals_damage": "no"
            },
            {
              "cause": "fire",
              "deals_damage": "no"
            },
            {
              "cause": "fall",
              "deals_damage": false
            }
          ]
        },
        "minecraft:knockback_resistance": {
          "value": 0.75
        },
        "minecraft:reflect_projectiles": {}
      },
      "dungeons:shockwave_recovery": {
        "minecraft:timer": {
          "looping": false,
          "time": 0.49,
          "time_down_event": {
            "event": "dungeons:shockwave_end",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.73,
        "height": 1.96
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 200 : 50"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/boss_wildfire.json"
      },
      "minecraft:knockback_resistance": {
        "value": 0.5
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:health": {
        "value": 500,
        "max": 500
      },
      "minecraft:spell_effects": {
        "add_effects": [
          {
            "effect": "slow_falling",
            "duration": 999999,
            "visible": false
          }
        ]
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 32
      },
      "minecraft:boss": {
        "should_darken_sky": false,
        "hud_range": 48,
        "name": "dungeons.bossbar.hovering_inferno"
      },
      "minecraft:scale": {
        "value": 2.2
      },
      "minecraft:fire_immune": {},
      "minecraft:nameable": {},
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "snowgolem"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "irongolem"
                }
              ]
            },
            "max_dist": 24
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 4,
        "speed_multiplier": 1
      },
      "minecraft:behavior.random_look_around": {
        "priority": 5
      },
      "minecraft:type_family": {
        "family": [
          "dungeons_musicbox",
          "blaze",
          "monster",
          "mob",
          "boss",
          "boss_wildfire",
          "wildfire"
        ]
      },
      "minecraft:physics": {},
      "minecraft:movement": {
        "value": 0.21
      },
      "minecraft:home": {
        "restriction_radius": 32,
        "restriction_type": "random_movement"
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "lava",
            "deals_damage": "no"
          },
          {
            "cause": "fire_tick",
            "deals_damage": "no"
          },
          {
            "cause": "fire",
            "deals_damage": "no"
          }
        ]
      }
    },
    "events": {
      "dungeons:harm_shield": {
        "randomize": [
          {
            "weight": 2,
            "trigger": "dungeons:harm_shield_1"
          },
          {
            "weight": 1,
            "trigger": "dungeons:harm_shield_2"
          }
        ],
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:harm_shield"
          ]
        }
      },
      "dungeons:harm_shield_1": {
        "set_property": {
          "dungeons:durability": "query.property('dungeons:durability') - 1"
        },
        "queue_command": {
          "command": [
            "particle minecraft:lava_particle ~~1~",
            "playsound mob.wildfire.shield_impact @a ~~~ 1.0 0.8",
            "scriptevent jagsby_nether:boss_event dungeons:harm_shield_1"
          ]
        }
      },
      "dungeons:harm_shield_2": {
        "set_property": {
          "dungeons:durability": "query.property('dungeons:durability') - 2"
        },
        "queue_command": {
          "command": [
            "particle minecraft:lava_particle ~~1~",
            "playsound mob.wildfire.shield_impact @a ~~~ 1.0 0.8",
            "scriptevent jagsby_nether:boss_event dungeons:harm_shield_2"
          ]
        }
      },
      "dungeons:destroy_shield": {
        "set_property": {
          "dungeons:shields": "query.property('dungeons:shields') - 1",
          "dungeons:durability": "10"
        },
        "queue_command": {
          "command": [
            "particle dungeons:wildfire_flames ~~1~",
            "playsound mob.wildfire.shield_break @a ~~~ 1.0 1.5",
            "scriptevent jagsby_nether:boss_event dungeons:destroy_shield"
          ]
        }
      },
      "dungeons:shields_down": {
        "remove": {
          "component_groups": [
            "dungeons:shielded"
          ]
        },
        "add": {
          "component_groups": [
            "dungeons:no_shield"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:shields_down"
          ]
        }
      },
      "dungeons:shields_up": {
        "add": {
          "component_groups": [
            "dungeons:shielded"
          ]
        },
        "remove": {
          "component_groups": [
            "dungeons:no_shield"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:shields_up"
          ]
        }
      },
      "dungeons:shockwave_damage": {
        "remove": {
          "component_groups": [
            "dungeons:shockwave_action"
          ]
        },
        "add": {
          "component_groups": [
            "dungeons:shockwave_recovery"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:shockwave_damage"
          ]
        }
      },
      "dungeons:shockwave_end": {
        "add": {
          "component_groups": [
            "dungeons:shockwave_cooldown"
          ]
        },
        "remove": {
          "component_groups": [
            "dungeons:shockwave_action",
            "dungeons:shockwave_recovery"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:shockwave_end"
          ]
        }
      },
      "dungeons:end_cooldown": {
        "add": {
          "component_groups": [
            "dungeons:shockwave_ready"
          ]
        },
        "remove": {
          "component_groups": [
            "dungeons:shockwave_cooldown"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:end_cooldown"
          ]
        }
      },
      "dungeons:begin_shockwave": {
        "set_property": {
          "dungeons:durability": "query.property('dungeons:durability') + 1"
        },
        "add": {
          "component_groups": [
            "dungeons:shockwave_action"
          ]
        },
        "remove": {
          "component_groups": [
            "dungeons:shockwave_ready",
            "dungeons:shockwave_cooldown",
            "dungeons:shockwave_recovery"
          ]
        },
        "queue_command": {
          "command": [
            "playsound mob.wither.ambient @a ~~~ 1.0 0.5",
            "effect @s slowness 1 9 true",
            "effect @s resistance 1 9 true",
            "effect @s regeneration 2 4 true",
            "playanimation @s animation.wildfire2.slam",
            "scriptevent jagsby_nether:boss_event dungeons:begin_shockwave"
          ]
        }
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "dungeons:shielded",
            "dungeons:shockwave_ready"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event minecraft:entity_transformed"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "dungeons:shielded",
            "dungeons:shockwave_ready"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event minecraft:entity_spawned"
          ]
        }
      },
      "jagsby_nether:resume_combat": {
        "remove": {
          "component_groups": [
            "dungeons:shockwave_action",
            "dungeons:shockwave_recovery",
            "dungeons:shockwave_cooldown"
          ]
        },
        "add": {
          "component_groups": [
            "dungeons:shockwave_ready"
          ]
        },
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event jagsby_nether:resume_combat"
          ]
        }
      }
    }
  }
}
