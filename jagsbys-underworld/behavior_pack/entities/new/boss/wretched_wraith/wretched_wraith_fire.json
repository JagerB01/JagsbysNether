{
  "format_version": "1.21.130",
  "minecraft:entity": {
    "description": {
      "identifier": "dungeons:wretched_wraith_fire",
      "is_summonable": true,
      "is_spawnable": false,
      "is_experimental": false
    },
    "component_groups": {
      "dungeons:despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:rotation_axis_aligned": {},
      "minecraft:body_rotation_blocked": {},
      "minecraft:cannot_be_attacked": {},
      "minecraft:vibration_damper": {},
      "minecraft:transient": {},
      "minecraft:tameable": {},
      "minecraft:type_family": {
        "family": [
          "ignore",
          "dungeons_fire"
        ]
      },
      "minecraft:health": {
        "max": 20,
        "value": 20
      },
      "minecraft:timer": {
        "looping": false,
        "time": 20,
        "time_down_event": {
          "event": "dungeons:despawn"
        }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "pivot": [
              0,
              1000,
              0
            ],
            "width": 0,
            "height": 0
          }
        ]
      },
      "minecraft:physics": {
        "has_collision": false,
        "has_gravity": false
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:collision_box": {
        "width": 0.01,
        "height": 0.01
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "in_water",
              "subject": "self",
              "value": true
            },
            "event": "dungeons:despawn"
          }
        ]
      },
      "minecraft:entity_sensor": {
        "subsensors": [
          {
            "cooldown": 0.5,
            "range": [
              0.8,
              2
            ],
            "minimum_count": 1,
            "event_filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "mob"
                }
              ]
            },
            "event": "dungeons:wraith_fire_hit"
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event minecraft:entity_spawned"
          ]
        }
      },
      "dungeons:wraith_fire_hit": {
        "queue_command": {
          "command": [
            "scriptevent jagsby_nether:boss_event dungeons:wraith_fire_hit"
          ]
        }
      },
      "dungeons:despawn": {
        "add": {
          "component_groups": [
            "dungeons:despawn"
          ]
        }
      }
    }
  }
}
