            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "skeleton"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "sheep"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "rabbit"
                  },
                  {
