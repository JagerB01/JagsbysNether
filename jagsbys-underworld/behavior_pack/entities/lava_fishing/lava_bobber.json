{
  "format_version": "1.21.100",
  "minecraft:entity": {
    "description": {
      "identifier": "jagsby_nether:lava_bobber",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "jagsby_nether:fishing_biome": {
          "type": "int",
          "range": [
            0,
            4
          ],
          "default": 0,
          "client_sync": false
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.1,
        "height": 0.1
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:fire_immune": {},
      "minecraft:persistent": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:type_family": {
        "family": [
          "inanimate",
          "jagsby_lava_bobber"
        ]
      }
    },
    "component_groups": {
      "cleanup": {
        "minecraft:instant_despawn": {}
      },
      "active_timer": {
        "minecraft:timer": {
          "time": 90,
          "looping": false,
          "time_down_event": {
            "event": "jagsby_nether:cleanup",
            "target": "self"
          }
        }
      },
      "floating": {
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": false
        }
      }
    },
    "events": {
      "jagsby_nether:cleanup": {
        "add": {
          "component_groups": [
            "cleanup"
          ]
        }
      },
      "jagsby_nether:classify": {
        "sequence": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "nether_wastes"
                }
              ]
            },
            "set_property": {
              "jagsby_nether:fishing_biome": 1
            }
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "crimson_forest"
                },
                {
                  "test": "has_biome_tag",
                  "value": "warped_forest"
                }
              ]
            },
            "set_property": {
              "jagsby_nether:fishing_biome": 2
            }
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "soulsand_valley"
                }
              ]
            },
            "set_property": {
              "jagsby_nether:fishing_biome": 3
            }
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "value": "basalt_deltas"
                }
              ]
            },
            "set_property": {
              "jagsby_nether:fishing_biome": 4
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "active_timer"
          ]
        }
      },
      "jagsby_nether:keep_alive": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "active_timer"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "active_timer"
              ]
            }
          }
        ]
      },
      "jagsby_nether:float": {
        "add": {
          "component_groups": [
            "floating"
          ]
        }
      }
    }
  }
}
