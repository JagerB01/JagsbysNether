{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.jagsby_nether.rod_use": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "casting": "context.is_first_person && query.cooldown_time_remaining('jagsby_nether:rod_swing') > 0.0"
            }
          ],
          "on_entry": [
            "variable.swing_active = 0.0;",
            "variable.swing_elapsed = 0.0;"
          ],
          "blend_transition": 0.08
        },
        "casting": {
          "animations": [
            "vanilla_use"
          ],
          "transitions": [
            {
              "settling": "variable.swing_elapsed >= 0.35"
            }
          ],
          "blend_transition": 0.08,
          "on_entry": [
            "variable.swing_elapsed = 0.0;",
            "variable.swing_active = 1.0;"
          ],
          "on_exit": [
            "variable.swing_active = 0.0;"
          ]
        },
        "settling": {
          "on_entry": [
            "variable.swing_active = 0.0;"
          ],
          "transitions": [
            {
              "idle": "query.cooldown_time_remaining('jagsby_nether:rod_swing') <= 0.0"
            }
          ]
        }
      }
    }
  }
}
