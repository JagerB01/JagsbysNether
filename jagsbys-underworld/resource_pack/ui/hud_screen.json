{
  "namespace": "hud",
  "boss_health_panel": {
    "type": "panel",
    "size": [
      182,
      20
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$progress_bar_collection": "boss_bars",
    "controls": [
      {
        "boss_name@boss_name_panel": {}
      },
      {
        "progress_bar_for_collections@common.progress_bar_for_collections": {
          "offset": [
            0,
            10
          ]
        }
      },
      {
        "namelessone_health@namelessone_health": {
          "offset": [
            0,
            -50
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#bossName",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#bossName = '§6Malzareth, Lord of Decay')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "wretchedwraith_health@wretchedwraith_health": {
          "offset": [
            0,
            -50
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#bossName",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#bossName = '§dNerezhal, Lord of Lamentation')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "wretchedwraith2_health@wretchedwraith2_health": {
          "offset": [
            0,
            -50
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#bossName",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#bossName = '§5Nerezhal, Lord of Lamentation')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bosswildfire_health@bosswildfire_health": {
          "offset": [
            0,
            -50
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#bossName",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#bossName = '§cBaelgor, Lord of Ruin')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#bar_visible",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      },
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars"
      }
    ]
  },
  "namelessone_health": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [
      300,
      128
    ],
    "bindings": [
      {
        "binding_name": "(#bossName = '§6Malzareth, Lord of Decay')",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "empty_namelessone_health@empty_namelessone_health": {
          "layer": 1,
          "keep_ratio": false
        }
      },
      {
        "filled_namelessone_bossbar@filled_namelessone_bossbar": {
          "layer": 2,
          "keep_ratio": false
        }
      },
      {
        "overlay_namelessone_bossbar@overlay_namelessone_bossbar": {
