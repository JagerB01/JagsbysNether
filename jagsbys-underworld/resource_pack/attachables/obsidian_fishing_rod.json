{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "jagsby_nether:obsidian_fishing_rod",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/lava_fishing/obsidian_fishing_rod",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.jagsby_nether.obsidian_rod"
      },
      "animations": {
        "hold": "animation.jagsby_nether.rod_hold",
        "use_controller": "controller.animation.jagsby_nether.rod_use",
        "vanilla_use": "animation.player.first_person.attack_rotation_item"
      },
      "scripts": {
        "animate": [
          "hold",
          "use_controller"
        ],
        "pre_animation": [
          "variable.swing_elapsed = (variable.swing_active ?? 0.0) ? (variable.swing_elapsed ?? 0.0) + query.delta_time : 0.0;",
          "variable.attack_time = (variable.swing_active ?? 0.0) ? math.clamp(1.0 - variable.swing_elapsed / 0.35, 0.0, 1.0) : 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
