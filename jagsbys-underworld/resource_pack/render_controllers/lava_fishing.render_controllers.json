{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.jagsby_lava_bobber": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.jagsby_obsidian_fishing_rod": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "query.is_enchanted ? Material.enchanted : Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ]
    }
  }
}
