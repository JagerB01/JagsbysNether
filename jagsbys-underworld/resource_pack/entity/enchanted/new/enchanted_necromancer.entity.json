{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "dungeons:enchanted_necromancer",
      "materials": {
        "default": "entity_emissive_alpha",
        "glow": "entity_emissive",
        "enchanted": "underworld_dungeons_enchant"
      },
      "textures": {
        "default": "textures/entity/enchanted_mob/necromancer",
        "enchanted": "textures/misc/enchanted_entity_glint"
      },
      "geometry": {
        "default": "geometry.necromancer"
      },
      "render_controllers": [
        "controller.render.necromancer",
        "controller.render.dungeons_entity_enchanted"
      ],
      "animations": {
        "walk": "animation.necromancer.walk",
        "cast_controller": "controller.animation.necromancer.cast",
        "particles": "animation.necromancer_shot.particles",
        "cast": "animation.necromancer.cast",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
