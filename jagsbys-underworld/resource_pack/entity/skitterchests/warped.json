{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "jagsby_nether:warped_skitterchest",
      "materials": {
        "default": "cow"
      },
      "textures": {
        "default": "textures/entity/skitterchests/warped"
      },
      "geometry": {
        "default": "geometry.jagsby_nether.warped_skitterchest"
      },
      "animations": {
        "setup": "animation.jagsby_nether.warped_skitterchest.setup",
        "walk": "animation.jagsby_nether.warped_skitterchest.walk",
        "look_at_target": "animation.common.look_at_target",
        "sitting": "animation.jagsby_nether.warped_skitterchest.sitting"
      },
      "scripts": {
        "animate": [
          {
            "setup": "1.0 - variable.sit_amount"
          },
          {
            "walk": "query.modified_move_speed * (1.0 - variable.sit_amount)"
          },
          "look_at_target",
          "sitting"
        ],
        "initialize": [
          "variable.sit_amount = 0.0;"
        ],
        "pre_animation": [
          "variable.sit_amount = math.lerp(variable.sit_amount, query.property('jagsby_nether:sitting') ? 1.0 : 0.0, math.min(query.delta_time * 8.0, 1.0));"
        ]
      },
      "render_controllers": [
        "controller.render.jagsby_nether.skitterchest"
      ],
      "spawn_egg": {
        "texture": "jagsby_warped_skitterchest_spawn_egg"
      }
    }
  }
}
