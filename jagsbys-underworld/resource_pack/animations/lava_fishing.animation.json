{
  "format_version": "1.8.0",
  "animations": {
    "animation.jagsby_lava_bobber.line": {
      "loop": true,
      "bones": {
        "line": {
          "rotation": [
            "query.property('jagsby_nether:line_pitch')",
            "query.property('jagsby_nether:line_yaw')",
            0
          ],
          "scale": [
            1,
            1,
            "query.property('jagsby_nether:line_length')"
          ]
        }
      }
    },
    "animation.jagsby_obsidian_fishing_rod.hold": {
      "loop": true,
      "bones": {
        "rod": {
          "position": [
            "context.is_first_person ? -1 : 0",
            "context.is_first_person ? -2 : 0",
            "context.is_first_person ? 1 : 0"
          ],
          "rotation": [
            0,
            "context.is_first_person ? -90 : 0",
            "context.is_first_person ? 25 : 0"
          ],
          "scale": 0.8
        }
      }
    }
  }
}
